# Example environment file for SafetyIQ
# Copy to .env.local and adjust model keys to match LM Studio.

# LM Studio local server WebSocket URL
LMSTUDIO_BASE_URL=ws://127.0.0.1:1234

# Vision + harm watch — use your loaded UCF model key from LM Studio
LMSTUDIO_WATCH_MODEL=lfm-ucf

# Compound risk LLM explanations
RISK_LLM_MODEL_KEY=lfm-ucf

# Video watch frame analysis (vision)
VIDEO_WATCH_FRAME_MODEL_KEY=lfm-ucf

# Video watch summary/chat (text)
VIDEO_WATCH_SUMMARY_MODEL_KEY=liquid/lfm2.5-1.2b

# Demo scenario ramp duration in sensor ticks (~seconds)
SCENARIO_RAMP_STEPS=30

# Sensor SSE tick interval (ms)
SENSOR_TICK_INTERVAL_MS=1000

# Set false to force template explanations without LLM calls
# RISK_LLM_ENABLED=true
# Fall back to a deterministic template if LM Studio does not answer in time
# RISK_LLM_TIMEOUT_MS=8000
